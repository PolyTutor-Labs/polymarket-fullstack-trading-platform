# Polymarket API
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=

# Bot Settings
PAPER_MODE=true
DEFAULT_INTERVAL=300

# Live-trade backstop (2026-05-23). Even with module.status='active'
# in Supabase, live trades require ALLOW_LIVE_TRADING=true here. Without
# this, a single Supabase row flip would route real money. Default: false.
ALLOW_LIVE_TRADING=false

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Supabase (frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8010

# Dashboard password gate (web/middleware.ts). Empty = HTTP 503, no access.
DASHBOARD_PASSWORD=

# Risk Defaults (override in Settings UI)
BANKROLL=1000
KELLY_FRACTION=0.25

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3010

# Optional Google Workspace impersonation for research/canonical Sheet helpers.
# Unused by the production FastAPI engine. Leave empty unless you run those scripts.
GOOGLE_ACCOUNT_EMAIL=

# Optional wallet used by a few research tape studies. Leave empty unless needed.
RESEARCH_WALLET_ADDRESS=

# LunarCrush
LUNARCRUSH_API_KEY=

# Anthropic (for news regime classification — uses Haiku, ~$0.01/call)
ANTHROPIC_API_KEY=

# Slack notifications (trade alerts, circuit breaker, daily summary)
SLACK_WEBHOOK_URL=

# Optional root for large local/runtime datasets (canonical parquet, L2, recordings, OSINT).
# Relative paths are resolved from the project root. Default keeps the existing layout.
POLYTUTOR_DATA_DIR=./_DataMetricPulls

# Generated analysis/backtest output, caches, and scratch files.
POLYTUTOR_OUTPUT_DIR=./output
